# Supabase (browser-safe values only). Project URL only — not the /rest/v1 endpoint.
VITE_SUPABASE_URL_TATER=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY_TATER=your-anon-or-publishable-key

# Optional: independent API Gateway sync endpoint (lib/sync/api-client.ts)
VITE_API_URL=

# Server-side only. Set these as Amplify secrets, never in .env used by Vite:
#   npx ampx sandbox secret set TMDB_ACCESS_TOKEN
#   npx ampx sandbox secret set VITE_SUPABASE_SECRET_KEY_TATER
