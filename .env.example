# Supabase (browser-safe values only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional: independent API Gateway sync endpoint (lib/sync/api-client.ts)
VITE_API_URL=

# Server-side only. Set these as Amplify secrets, never in .env used by Vite:
#   npx ampx sandbox secret set TMDB_ACCESS_TOKEN
#   npx ampx sandbox secret set VITE_SUPABASE_SECRET_KEY
